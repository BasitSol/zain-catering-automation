# Copy this file to .env and fill in real values before running docker-compose up
# NEVER commit the real .env file to git

# --- Postgres ---
POSTGRES_USER=zain_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=zain_catering

# --- n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Once Cloudflare Tunnel is set up, WEBHOOK_URL becomes your real domain, e.g.:
# WEBHOOK_URL=https://automation.zaincatering.com/
# N8N_HOST=automation.zaincatering.com
# N8N_PROTOCOL=https

# --- Cloudflare Tunnel ---
# Generate this by running (one-time, on the host machine, not in docker):
#   cloudflared tunnel login
#   cloudflared tunnel create zain-n8n
#   cloudflared tunnel token zain-n8n
CLOUDFLARE_TUNNEL_TOKEN=paste_your_tunnel_token_here
